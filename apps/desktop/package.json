{
  "name": "foxtail-microfiche-desktop",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "Foxtail Microfiche archival newspaper research workstation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n WEB,ELECTRON \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --configLoader native --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:web": "tsc --noEmit && vite build --configLoader native",
    "check": "npm run build:web && node scripts/engine-registry-smoke.cjs && node scripts/ui-smoke.cjs && node scripts/issue-reels-smoke.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
